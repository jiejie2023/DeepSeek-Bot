node_modules/
*.tgz
# The desktop app's window build (npm run build in app/), its packages (npm run pack, npm run dist)
# and the next version that checks its update (see app/README.md).
/app/ui/dist/
/app/dist-pack/
/app/dist-next/

# A DeepSeek Harness checkout for the tests and the test bench.
/deepseek-harness/

# Test bench, local DSH data and the screenshots of dev/check.sh.
.dsh-test*/
.dsh-home/
/shots/
.playwright-mcp/

# Extra patterns for scripts/scan.mjs that must not be named in the repository.
.scan-extra

# Local Docker deployment data.
/docker/data/
/docker/workspace/
/docker/.env
/.env
/docker-compose.override.yml

# Bytecode from the record-browser-gif encoder's local media tests.
__pycache__/

# 安卓签名资产一律不入库（源自参考仓库的 apps/mobile/signing 含 .p12/.cer，绝不引入）
apps/mobile/signing/
*.p12
*.pfx
*.jks
*.keystore
*.cer
